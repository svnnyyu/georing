    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mapshaper": "^0.7.101",
    "typescript": "~5.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
