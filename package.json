{
  "name": "georing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "python3 pipeline/build_cities.py && python3 pipeline/build_geo.py && python3 pipeline/build_land.py"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "mapshaper": "^0.7.101",
    "typescript": "~5.9.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
